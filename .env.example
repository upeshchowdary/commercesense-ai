# Required for the live agents (Phase 1-3)
GEMINI_API_KEY=your_gemini_key_here
TAVILY_API_KEY=your_tavily_key_here

# Shared paths  safe to leave as defaults
DECISION_LOG_PATH=decisions.log.jsonl
CACHE_DB_PATH=research_cache.db
SQLITE_DB_PATH=amazon_copilot.db
RESEARCH_AGENT_MODEL=gemini-3.6-flash
INSIGHT_AGENT_MODEL=gemini-3.6-flash

# Intelligence modules (Listing / Pricing / Review / Inventory) -- all
# optional. Deterministic analysis always works with none of this set.
ENABLE_LISTING_INTELLIGENCE=true
ENABLE_PRICING_INTELLIGENCE=true
ENABLE_REVIEW_INTELLIGENCE=true
ENABLE_INVENTORY_INTELLIGENCE=true

# LLM_PROVIDER selects the optional explanation layer: "ollama" (free,
# local, default) or "gemini" (reuses GEMINI_API_KEY above).
# Also: "groq", "openrouter", or "auto" (tries LLM_CHAIN in order, first
# provider that answers wins).
LLM_PROVIDER=ollama
LLM_CHAIN=gemini,groq,openrouter,ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:4b
INTELLIGENCE_GEMINI_MODEL=gemini-3.6-flash

# Optional, never required -- the app works fully in DEMO/CSV mode without
# any of these set.
ENABLE_SP_API=false
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=
ENABLE_SEARXNG=false
SEARXNG_URL=

# ---------------------------------------------------------------------------
# Free integrations (Phase 10). Everything below is optional and free-tier.
# ---------------------------------------------------------------------------

# GEMINI_API_KEY (above): free key from Google AI Studio (aistudio.google.com).
# TAVILY_API_KEY (above): Tavily's free plan, 1,000 credits/month, no card.

# Groq -- free API key from console.groq.com. Check Groq's rate-limits page
# for current free-plan limits and model IDs before relying on a model.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter -- free key from openrouter.ai. There is no default model on
# purpose: choose one whose ID ends in ":free" from openrouter.ai/models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# US CPSC product-recall check. NO key needed. Runs only when the user clicks
# "Check recalls" on a product's Safety tab.
ENABLE_RECALL_CHECK=true

# Key-less search fallback (the `ddgs` package, in requirements-optional.txt).
# Only used when Tavily is missing or returns nothing. Unofficial scraping of
# public search engines: can be rate-limited or break without notice.
ENABLE_KEYLESS_SEARCH=false
